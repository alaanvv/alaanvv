  "hyprland/workspaces": {
    "format-icons": { "default": "▓▓" },
    "format": "{icon}", 
    "show-special": true, 
    "special-visible-only": true, 
    "persistent-workspaces": { "*": 2 }
  },

  "custom/clock": {
    "exec": "printf '{\"text\":\"%s\",\"class\":\"%s\"}' $(date +%H:%M) $(dunstctl is-paused | grep -q true && echo off)",
    "return-type": "json",
    "interval": 5,
    "on-click": "dunstctl set-paused toggle"
  },

  "network": {
    "format": "▓▓",
    "format-disconnected": "░░",
    "tooltip-format": "{essid}",
    "on-click": "iwctl device wlan0 set-property Powered $(iwctl device wlan0 show | grep -q Powered.*off && echo on || echo off)"
  },

  "bluetooth": {
    "format": "▓▓",
    "tooltip-format-connected": "{device_alias}",
    "tooltip-format-connected-battery": "{device_alias} ({device_battery_percentage}%)",
    "on-click": "bluetooth toggle"
  },

